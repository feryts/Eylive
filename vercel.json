{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "destination": "https://eyliveapp.vercel.app/",
      "permanent": false
    },
    {
      "source": "/v2/",
      "destination": "https://eyliveapp.vercel.app/",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "https://eyliveapp.vercel.app/",
      "permanent": false
    },
    {
      "source": "/v2/:path*",
      "destination": "https://eyliveapp.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/admin/:path*",
      "destination": "https://eyliveapp.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "destination": "https://eyliveapp.vercel.app/:path*",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
